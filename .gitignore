/build
/dist
dist/
dist-ssr/
out/
.next/
.nuxt/
.vuepress/dist/

# Vite
.vite/
.vite-cache/

# Miscellaneous
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*


