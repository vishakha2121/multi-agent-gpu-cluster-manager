gitignore
# ================================================================
# MULTI-AGENT GPU CLUSTER MANAGER — .gitignore
# ================================================================
# Ye file batati hai Git ko kaunsi files IGNORE karni hain
# (yani GitHub pe push NAHI karni)
# ================================================================


# ================================================================
# 1. PYTHON
# ================================================================
__pycache__/
*.py[cod]*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
env/
ENV/
.venv/
pythonenv*/
.python-version

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
pytestdebug.log

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath
*.sage.py

# Environments
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# mkdocs
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype
.pytype/

# Cython
cython_debug/


# ================================================================
# 2. SECRETS & ENVIRONMENT (⚠️ VERY IMPORTANT)
# ================================================================
.env
.env.*
!.env.example
*.key
*.pem
*.crt
secrets.json
credentials.json
config.local.json
*secret*
*credential*
api_keys.txt


# ================================================================
# 3. DATABASE FILES
# ================================================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
!backend/data/.gitkeep


# ================================================================
# 4. NODE / JAVASCRIPT / REACT
# ================================================================
node_modules/
node_modules
/.pnp
.pnp.js
.pnp.cjs

# Testing
/coverage
coverage/
*.lcov

# Production build
/build
/dist
dist/
dist-ssr/
out/
.next/
.nuxt/
.vuepress/dist/

# Vite
.vite/
.vite-cache/

# Miscellaneous
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*


# ================================================================
# 5. IDE / EDITOR
# ================================================================
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace



