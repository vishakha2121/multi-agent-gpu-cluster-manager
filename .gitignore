# 2. SECRETS & ENVIRONMENT (⚠️ VERY IMPORTANT)
# ================================================================
.env
.env.*
!.env.example
*.key
*.pem
*.crt
secrets.json
credentials.json
config.local.json
*secret*
*credential*
api_keys.txt


# ================================================================
# 3. DATABASE FILES
# ================================================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
!backend/data/.gitkeep


# ================================================================
# 4. NODE / JAVASCRIPT / REACT
# ================================================================
node_modules/
node_modules
/.pnp
.pnp.js
.pnp.cjs

# Testing
/coverage
coverage/
*.lcov

